# FraudDNA Environment Configuration Template
# Copy this file to .env for local development: cp .env.example .env
# DO NOT COMMIT REAL SECRETS OR API KEYS TO GIT

# ==========================================
# Application Settings
# ==========================================
APP_NAME=FraudDNA
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ==========================================
# Frontend Configuration
# ==========================================
NEXT_PUBLIC_APP_NAME=FraudDNA
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
PORT=3000

# ==========================================
# Database Configuration (PostgreSQL + pgvector)
# ==========================================
POSTGRES_USER=frauddna_user
POSTGRES_PASSWORD=frauddna_password
POSTGRES_DB=frauddna_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://frauddna_user:frauddna_password@localhost:5432/frauddna_db
DATABASE_URL_SYNC=postgresql://frauddna_user:frauddna_password@localhost:5432/frauddna_db

# ==========================================
# CORS Settings
# ==========================================
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://fraud-dna.vercel.app"]

# ==========================================
# AI / LLM Configuration Placeholders (Phase 5+)
# ==========================================
# Provider: openai | anthropic | gemini
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_placeholder
GEMINI_API_KEY=your_gemini_api_key_placeholder
ANTHROPIC_API_KEY=your_anthropic_api_key_placeholder
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_STEPS=10
LLM_TIMEOUT_SECONDS=30

# ==========================================
# Embedding & RAG Configuration Placeholders (Phase 4+)
# ==========================================
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
