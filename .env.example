# ==============================================================================
# FraudDNA V2 — Environment Configuration Template
# ==============================================================================

# Core Application Settings
APP_NAME=FraudDNA
APP_ENV=development  # Set to "production" in live environments
DEBUG=True
LOG_LEVEL=INFO
LOG_FORMAT=console    # Use "json" in production for structured cloud observability
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1

# Security Settings
# In production, SECRET_KEY must be a cryptographically generated 32+ character string
SECRET_KEY=insecure-dev-secret-key-change-in-production
REQUEST_ID_HEADER=X-Request-ID
CORRELATION_ID_HEADER=X-Correlation-ID

# Allowed CORS Origins (JSON array or comma-separated list)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://fraud-dna.vercel.app"]

# Database Configuration (PostgreSQL 16 + pgvector)
# Change user/password/host in production deployments
DATABASE_URL=postgresql+asyncpg://frauddna_user:frauddna_password@localhost:5432/frauddna_db
DATABASE_URL_SYNC=postgresql://frauddna_user:frauddna_password@localhost:5432/frauddna_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30.0

# V2 Persistence Feature Flags
ENABLE_PERSISTENT_STORAGE=False
V2_FEATURES_ENABLED=True

# ML & Feature Pipeline Settings
ML_MODELS_DIR=ml/models
ML_DATA_PATH=ml/data/transactions.csv
ML_FEATURE_COUNT=18
ML_DEFAULT_THRESHOLD=0.37

# AI Investigation Agent Settings
LLM_PROVIDER=deterministic  # "deterministic" for offline fallback, "openai" for GPT-4o
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_API_BASE=https://api.openai.com/v1
AGENT_MAX_STEPS=8
AGENT_TIMEOUT_SECONDS=30.0

# Deterministic Policy Matrix
POLICY_VERSION=2025.1
