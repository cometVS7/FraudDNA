# FraudDNA Environment Configuration Template
# Copy this file to .env for local development: cp .env.example .env
# DO NOT COMMIT REAL SECRETS OR API KEYS TO GIT

# ==========================================
# Application Settings
# ==========================================
APP_NAME=FraudDNA
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=console
API_V1_PREFIX=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ==========================================
# V2 Feature Flags (Conservative defaults)
# ==========================================
ENABLE_PERSISTENT_STORAGE=false
V2_FEATURES_ENABLED=false

# ==========================================
# Security & Correlation
# ==========================================
REQUEST_ID_HEADER=X-Request-ID
CORRELATION_ID_HEADER=X-Correlation-ID
SECRET_KEY=insecure-dev-secret-key-change-in-production

# ==========================================
# Frontend Configuration
# ==========================================
NEXT_PUBLIC_APP_NAME=FraudDNA
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
PORT=3000

# ==========================================
# Database Configuration (PostgreSQL + pgvector)
# ==========================================
POSTGRES_USER=frauddna_user
POSTGRES_PASSWORD=frauddna_password
POSTGRES_DB=frauddna_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://frauddna_user:frauddna_password@localhost:5432/frauddna_db
DATABASE_URL_SYNC=postgresql://frauddna_user:frauddna_password@localhost:5432/frauddna_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30.0

# ==========================================
# CORS Settings
# ==========================================
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://fraud-dna.vercel.app"]

# ==========================================
# ML & Feature Pipeline
# ==========================================
ML_MODELS_DIR=ml/models
ML_DATA_PATH=ml/data/transactions.csv
ML_DEFAULT_THRESHOLD=0.37

# ==========================================
# AI / LLM Configuration Placeholders (Phase 5+)
# ==========================================
# Provider: deterministic (default, offline fallback) | openai | anthropic | gemini
LLM_PROVIDER=deterministic
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_API_BASE=https://api.openai.com/v1
AGENT_MAX_STEPS=8
AGENT_TIMEOUT_SECONDS=30.0

# ==========================================
# Policy Engine
# ==========================================
POLICY_VERSION=2025.1
